{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        metosin/malli {:mvn/version "0.20.1"}}

 :aliases
 {:dev  {:extra-paths ["dev" "test"]
         :extra-deps {org.clojure/data.json {:mvn/version "2.5.2"} io.github.hive-agi/hive-spi {:mvn/version "1.1.0"} io.github.hive-agi/hive-addon {:mvn/version "1.0.5"}}}

  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       org.clojure/test.check {:mvn/version "1.1.3"}
                       io.github.hive-agi/hive-test {:mvn/version "0.4.5"}
                       io.github.hive-agi/hive-schemas {:mvn/version "0.1.33"}
                       org.clojure/data.json {:mvn/version "2.5.2"}
                       io.github.hive-agi/hive-spi {:mvn/version "1.1.0"}
                       io.github.hive-agi/hive-addon {:mvn/version "1.0.5"}}
         :main-opts ["-m" "cognitect.test-runner" "-e" ":integration"]
         :exec-fn cognitect.test-runner.api/test}

  ;; Real editor round-trips: emacs --batch and headless vim must be on PATH.
  :integration {:extra-paths ["test"]
                :extra-deps  {io.github.cognitect-labs/test-runner
                              {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                              org.clojure/test.check {:mvn/version "1.1.3"}
                              io.github.hive-agi/hive-test {:mvn/version "0.4.5"}
                              io.github.hive-agi/hive-schemas {:mvn/version "0.1.33"}
                              org.clojure/data.json {:mvn/version "2.5.2"}
                              io.github.hive-agi/hive-spi {:mvn/version "1.1.0"}
                              io.github.hive-agi/hive-addon {:mvn/version "1.0.5"}}
                :main-opts ["-m" "cognitect.test-runner" "-i" ":integration"]}

  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.16"}}
          :ns-default hive-build.api}}}
