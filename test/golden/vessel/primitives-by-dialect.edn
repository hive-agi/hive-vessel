              {"text" "", "face" "plain"}
              {"text" "@@ -1,2 +1,2 @@", "face" "hunk"}
              {"text" "-(old)", "face" "removed"}
              {"text" "+(new ü)", "face" "added"}
              {"text" " context", "face" "plain"}
              {"text" "", "face" "plain"}
              {"text" "open a",
