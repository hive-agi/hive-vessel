{:emacs
 {:close-panel
  [{:op :vessel/native,
    :native/dialect :elisp,
    :native/payload
    "(let ((buf (get-buffer \"*hive:olympus/tab-2*\"))) (when buf (quit-windows-on buf t) (when (buffer-live-p buf) (kill-buffer buf)) t))"}],
  :notify-error
  [{:op :vessel/native,
    :native/dialect :elisp,
    :native/payload
    "(display-warning 'hive \"boom\\nsecond line\" :error)"}],
  :notify-info
  [{:op :vessel/native,
    :native/dialect :elisp,
    :native/payload "(message \"%s\" \"frame 7 applied\")"}],
  :open-file
  [{:op :vessel/native,
    :native/dialect :elisp,
    :native/payload
    "(progn (find-file \"/tmp/a b.clj\") (goto-char (point-min)) (forward-line 2) (move-to-column 6) (buffer-name))"}],
  :open-file-defaults
  [{:op :vessel/native,
    :native/dialect :elisp,
    :native/payload
    "(progn (find-file \"/tmp/a.clj\") (goto-char (point-min)) (buffer-name))"}],
  :send-to-terminal
  [{:op :vessel/native,
    :native/dialect :elisp,
    :native/payload
    "(let* ((buf (or (get-buffer \"*vterm*\") (error \"no terminal buffer %s\" \"*vterm*\"))) (text \"ls -la\\n\")) (with-current-buffer buf (cond ((and (derived-mode-p 'vterm-mode) (fboundp 'vterm-send-string)) (vterm-send-string text)) ((derived-mode-p 'term-mode) (term-send-raw-string text)) (t (process-send-string (get-buffer-process buf) text)))) t)"}],
  :show-panel
  [{:op :vessel/native,
    :native/dialect :elisp,
    :native/payload
    "(let ((buf (get-buffer-create \"*hive:olympus/tab-2*\"))) (require 'diff-mode nil t) (with-current-buffer buf (special-mode) (let ((inhibit-read-only t)) (erase-buffer) (insert (propertize \"Carto \\\"Flow\\\" \\\\ #3\" 'face '(:inherit bold :height 1.2)) \"\\n\") (insert \"\" \"\\n\") (insert (propertize \"apply write-form\" 'face 'bold) \"\\n\") (insert \"\" \"\\n\") (insert (propertize \"succeeded\" 'face 'success) \"\\n\") (insert \"\" \"\\n\") (insert \"paths  : src/a.clj\" \"\\n\") (insert \"         src/b.clj\" \"\\n\") (insert \"verify : ok\" \"\\n\") (insert \"\" \"\\n\") (insert \"  - one\" \"\\n\") (insert \"  - two\" \"\\n\") (insert \"    more\" \"\\n\") (insert \"\" \"\\n\") (insert (propertize \"    (defn f [] \\\"x\\\")\" 'face 'font-lock-constant-face) \"\\n\") (insert \"\" \"\\n\") (insert (propertize \"@@ -1,2 +1,2 @@\" 'face 'diff-hunk-header) \"\\n\") (insert (propertize \"-(old)\" 'face 'diff-removed) \"\\n\") (insert (propertize \"+(new ü)\" 'face 'diff-added) \"\\n\") (insert \" context\" \"\\n\") (insert \"\" \"\\n\") (insert-text-button \"open a\" 'follow-link t 'action (lambda (_button) (progn (find-file-other-window \"/tmp/a.clj\") (goto-char (point-min)) (forward-line 1) (buffer-name)))) (insert \"\\n\")) (goto-char (point-min))) (unless noninteractive (display-buffer buf)) (buffer-name buf))"}]},
